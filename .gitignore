.venv/
__pycache__/
*.pyc
.DS_Store
.env
*.pem
*.key
docker-compose.override.yml

# simulation outputs are large/non-deterministic-sized; never committed
artifacts/raw/*
artifacts/processed/*
!artifacts/raw/.gitkeep
!artifacts/processed/.gitkeep

# figures/logs/manifests are small and worth keeping selectively,
# but start ignored too -- unignore individual files deliberately when curating the final report
artifacts/logs/*
!artifacts/logs/.gitkeep

# authors' published reference archives (~2.8GB downloaded+extracted) -- never committed,
# re-downloadable from the experiment README links, MD5s recorded in docs/REFERENCE_DATA_AUDIT.md
artifacts/reference/
